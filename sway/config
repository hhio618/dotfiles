#----------------------------------------------------------------#
#               KISHORE'S SWAY CONFIGURATION                     #
#----------------------------------------------------------------#
#   Copy this to ~/.config/sway/config and edit it as you like.  #
#----------------------------------------------------------------#
#           Read `man 5 sway` for a complete reference.          #
#----------------------------------------------------------------#

#------------------------------------------------#
#              Set key shortcuts                 #
#------------------------------------------------#

# Setting $mod for logo key (windows key)
    set $mod Mod4

# Setting $alt for Alt key
    set $alt Mod1

#------------------------------------------------#
#            Setting up terminal                 # 
#------------------------------------------------#

set $term alacritty

#------------------------------------------------#
#       setting up application launcher          #
#------------------------------------------------#

set $menu rofi -show drun -theme ~/.config/rofi/theme.rasi

#------------------------------------------------#
#                 Look and Feel                  #
#------------------------------------------------#

# Remove window borders
    default_border none
    default_floating_border none

# Remove borders/titlebars for every app (all windows)
    for_window [class=".*"] border none
    titlebar_border_thickness 0
    titlebar_padding 0 0

# Gaps between windows
    gaps inner 10
    gaps outer 5

# Sway UI font
    font pango:SpaceMono Nerd Font 12

# Increase Wayland DPI / scaling (revert to 1.0 if things look too big)
    output * scale 1.25

#------------------------------------------------#
#                  Key bindings                  #
#------------------------------------------------#

# Kill focused window
    bindsym $mod+q kill

# Kill focused window (sway default)
    bindsym $mod+Shift+q kill

# Start a terminal (sway default)
    bindsym $mod+Return exec $term

# Drag/resize floating windows with $mod + mouse
    floating_modifier $mod normal

# Split horizontally / vertically
    bindsym $mod+Shift+v splith
    bindsym $mod+v splitv

# Change container layout
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

# Toggle fullscreen
    bindsym $mod+Shift+f fullscreen toggle

# Toggle floating and swap focus between tiling/floating
    bindsym $mod+Shift+space floating toggle
    bindsym $mod+space focus mode_toggle

# Focus the parent container
    bindsym $mod+a focus parent

# Scratchpad
    bindsym $mod+Shift+minus move scratchpad
    bindsym $mod+minus scratchpad show

# Start the launcher
    bindsym $mod+d exec $menu

# Reload the configuration file
    bindsym $mod+Shift+r reload

# Poweroff
    bindsym $mod+Shift+P exec systemctl poweroff

# Reboot
    bindsym $mod+Shift+O exec systemctl reboot

# Sleep
    bindsym $mod+L exec systemctl suspend

# Lock and Sleep
    bindsym $mod+Shift+L exec "swaylock -f && systemctl suspend"

# Wifi toggle
    bindsym $mod+Shift+W exec ~/.config/sway/scripts/wifi_toggle.sh

# Bluetooth toggle
    bindsym $mod+Shift+b exec ~/.config/sway/scripts/bluetooth_toggle.sh

# Exit sway
    bindsym $mod+Shift+e exec swaynag -t warning -m 'Do you really wanna exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

#------------------------------------------------#
#              Application Shorcuts              #
#------------------------------------------------#

# Execute Terminal
    bindsym $mod+x exec $term

# Execute web browser (Brave browser)
    bindsym $mod+b exec brave

# Execute File Manager (Nautilus - Gnome File Manager) Install using sudo pacman -S nautilus
    bindsym $mod+f exec nautilus

# Execute VS-Code
    bindsym $mod+c exec code

# Kill picom
    bindsym $mod+Ctrl+c exec --no-startup-id pkill picocom

#------------------------------------------------#
#           Hardware key controls.               #
#------------------------------------------------#
# Audio volume controls (PipeWire)
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 2.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
#Brightness up (Increases brightness by 5%)
    bindsym XF86MonBrightnessUp exec brightnessctl set +3%

#Brightness down (Decreases brightness by 5%)
    bindsym XF86MonBrightnessDown exec brightnessctl set 3%-

#------------------------------------------------#
#                 Moving around                  #
#------------------------------------------------#

# Move the focus - use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

# Move the focused window with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

#------------------------------------------------#
#                   Workspaces                   #
#------------------------------------------------#

# Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10

# Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10

# Switch to next workspace
    bindsym $mod+Tab workspace next

# Disable focus of containers on hover
    focus_follows_mouse no

#---------------------------------------------------#
#               Resizing containers                 #
#---------------------------------------------------#

mode "resize" {

# Resize windows with arrow key - $mod+R+[up|down|right|left] arrow keys
    bindsym Right resize shrink width 10px
    bindsym Left resize grow width 10px
    bindsym Up resize grow height 10px
    bindsym Down resize shrink height 10px

# Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

#-------------------------------------------------#
#               Floating Window                   #
#-------------------------------------------------#

# Toggle floating window is bound to $mod+Shift+space (see Key bindings).
# $mod+Shift+f is used for fullscreen, so we no longer bind floating there.

# Move floating window
    bindsym $alt+Left move left 10px
    bindsym $alt+Right move right 10px
    bindsym $alt+Up move up 10px
    bindsym $alt+Down move down 10px

# Resize floating windows
    bindsym $mod+$alt+Left  resize shrink width  20 px
    bindsym $mod+$alt+Right resize grow   width  20 px
    bindsym $mod+$alt+Up    resize grow   height 20 px
    bindsym $mod+$alt+Down  resize shrink height 20 px

#-------------------------------------------------#
#       Trackpad and mouse Configuration          #
#-------------------------------------------------#

# Touchpad
     input type:touchpad {
	natural_scroll enabled
	tap enabled
	dwt enabled
	scroll_method two_finger
    }

# Mouse
    input type:pointer {
	natural_scroll disabled
    }

# Keyboard

    input type:keyboard {
        xkb_layout "us,ir"
        xkb_options "grp:alt_shift_toggle"
    }

#------------------------------------------------#
#                    Waybar                      #
#------------------------------------------------#

#Display waybar
    exec_always sh -c "sleep 1; pgrep waybar >/dev/null && pkill waybar; waybar"

# Network Manager applet (shows in the waybar tray)
    exec nm-applet --indicator

# Touchpad gestures (swipe to switch workspaces)
    exec_always libinput-gestures-setup restart

#------------------------------------------------#
#                  Wallpaper                     #
#------------------------------------------------#

  output * bg ~/.config/wallpaper/wall.png fill

#------------------------------------------------#
#                Toggle Caffine                  #
#------------------------------------------------#

    bindsym $mod+Shift+c exec ~/.config/sway/scripts/caffeine.sh

# Kill swayidle

    exec_always sh -c 'pkill swayidle; ~/.config/sway/scripts/start_idle.sh' 

#------------------------------------------------#
#       Screenshot and ScreenRecording           #
#------------------------------------------------#

#take screenshot of entire screen
    bindsym Print exec grim - | tee ~/Pictures/Screenshots/screenshot_$(date +%F_%H-%M-%S).png | wl-copy && notify-send "Screenshot" "Full screen captured 📸"

#Take Screenshot of selected area
    bindsym Shift+Print exec grim -g "$(slurp)" - | tee ~/Pictures/Screenshots/screenshot_$(date +%F_%H-%M-%S).png | wl-copy && notify-send "Screenshot" "Area captured 📸"

# Record entire screen
    bindsym $alt+r exec wf-recorder -f ~/Videos/ScreenRecording/record_$(date +%F_%H-%M-%S).mp4 --audio=alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Headphones__sink.monitor && notify-send "ScreenRecording" "Recording captured 📸"

# Record selected area
    bindsym $mod+$alt+r exec wf-recorder -g "$(slurp)" -f ~/Videos/ScreenRecording/record_$(date +%F_%H-%M-%S).mp4 --audio=alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Headphones__sink.monitor && notify-send "ScreenRecording" "Recording captured 📸"

# Stop Recording
    bindsym $mod+Shift+s exec pkill wf-recorder

# Notifications are handled by the swaync user service (swaync.service).

include /etc/sway/config.d/*

